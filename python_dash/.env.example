# Copy this file to .env and fill in values for your warehouse.
# Mirrors the connection parameters used by the Power BI dashboards
# (see ../CLAUDE.md → "Connection pattern (cross-cutting)").

# When false, dashboards open without hitting the warehouse — partition
# queries return empty frames with the expected schema. Same behavior as
# the M-side `if load_data then <query> else #table(...)` gate.
LOAD_DATA=false

# One of: duckdb, snowflake, bigquery, redshift, odbc, sqlserver, fabric
DATA_WAREHOUSE_TYPE=duckdb

# Generic connection target — interpretation depends on warehouse type.
SERVER_NAME=
DATABASE_NAME=
COMPUTE_NAME=
ROLE_NAME=

# Prefix applied to Tuva schema names. Use the literal string "NULL"
# (matching the PBI param) for no prefix.
SCHEMA_PREPEND_NAME=NULL

# --- DuckDB-specific ---
# Path to your local Tuva DuckDB file. Relative paths resolve from python_dash/.
# Example for `dbt build` output of the tuva-health repo at ../tuva:
DUCKDB_DATABASE=../../tuva/tuva.duckdb

# --- Snowflake-specific ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=ACCOUNTADMIN
# Use SNOWFLAKE_AUTHENTICATOR=externalbrowser for SSO.
SNOWFLAKE_AUTHENTICATOR=

# --- BigQuery-specific ---
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT=

# --- Redshift / Postgres ---
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_PORT=5439

# --- ODBC / SQL Server / Fabric ---
ODBC_DRIVER=ODBC Driver 18 for SQL Server
ODBC_USER=
ODBC_PASSWORD=

# Optional: cap rows pulled from large fact tables (matches the
# `row_limit` parameter used by Risk-Adjusted Benchmarks). Empty = no cap.
ROW_LIMIT=

# Dash server settings
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=true
